INSTALL_DIR=@LOCI_INSTALL_DIR@

NO_SUB_DIR=@LOCI_NO_SUB_DIR01@
BOUNDS_CHECK=@LOCI_BOUNDS01@
@LOCI_MPI_SYSCONF@
@LOCI_HDF5_SYSCONF@

@LOCI_LIBXML2_SYSCONF@

@LOCI_METIS_SYSCONF@

@LOCI_CGNS_SYSCONF@
@LOCI_TEC_SYSCONF@
@LOCI_PETSC_SYSCONF@
@LOCI_CUDA_SYSCONF@

# POSIX threads setup
PTHREADS_DEFINE=@LOCI_PTHREADS_DEFINE@
PTHREADS_LIB= @LOCI_PTHREADS_LIB@

MISC=@LOCI_MISC@
MISC_LIBS=@LOCI_FORTRAN_LIBS@

# Dynamic Library Defines
DYNAMIC_LOADING_DEFINES =
DYNAMIC_LOADING_LINK = @LOCI_DYNAMIC_LOADING_LINK@

##############################################
# No need to change things below this line

MACHINE_SPECIFIC = $(PETSC_DEFINE) $(PETSC_INCLUDE) $(HDF5_INCLUDE)\
                   $(MPI_INCLUDE) $(METIS_INCLUDE) $(CGNS_INCLUDE) $(MISC)\
                   @LOCI_CUDA_MACHINE_SPECIFIC@$(DYNAMIC_LOADING_DEFINES) $(PTHREADS_DEFINE)

BASE_LIBS = $(HDF5_LIBS) $(PETSC_LIBS)  $(METIS_LIBS) \
            $(MISC_LIBS) $(CGNS_LIBS) $(DYNAMIC_LOADING_LINK) \
            @LOCI_CUDA_BASE_LIBS@$(MPI_LIBS) $(PTHREADS_LIB)
