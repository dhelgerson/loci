# Uninstall.cmake -- remove files placed by `cmake --install` (mirrors the
# legacy `make uninstall`, which removed each artifact individually).
# Reads the install manifest generated by the last `cmake --install`.
#   cmake -DBINARY_DIR=<build dir> -DPREFIX=<install prefix> -P this
#
# Directories emptied by the removal are pruned, but the install prefix
# itself is never deleted (same net effect as the legacy uninstall).

if(NOT EXISTS "${BINARY_DIR}/install_manifest.txt")
  message(FATAL_ERROR
    "Cannot find install manifest in ${BINARY_DIR}; nothing has been "
    "installed from this build tree.")
endif()

file(READ "${BINARY_DIR}/install_manifest.txt" _files)
string(REGEX REPLACE "[\r\n]+" ";" _files "${_files}")
list(REMOVE_ITEM _files "")

foreach(_f ${_files})
  if(EXISTS "${_f}" OR IS_SYMLINK "${_f}")
    message(STATUS "Uninstalling: ${_f}")
    file(REMOVE "${_f}")
  endif()
  # prune now-empty parent directories up to (not including) the prefix
  get_filename_component(_d "${_f}" DIRECTORY)
  while(NOT _d STREQUAL "${PREFIX}" AND NOT _d STREQUAL "/"
        AND NOT _d STREQUAL "")
    file(GLOB _left "${_d}/*")
    if(_left)
      break()
    endif()
    file(REMOVE_RECURSE "${_d}")
    get_filename_component(_d "${_d}" DIRECTORY)
  endwhile()
endforeach()
message(STATUS "Uninstall from ${PREFIX} complete (prefix directory itself "
  "kept if non-empty).")
